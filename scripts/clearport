#!/data/data/com.termux/files/usr/bin/bash
set -Eeuo pipefail

VERSION="0.1.0"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/clearport"
CONFIG_FILE="$CONFIG_DIR/server.conf"
API_BASE="http://127.0.0.1:${PORT:-8080}/v1"
SERVER_CMD="clearport-server"

usage() {
  cat <<'EOF'
Clearport CLI

Usage:
  clearport start          Start the local llama.cpp server
  clearport chat           Chat with the loaded model in Termux
  clearport models         Show models loaded by the server
  clearport local-models   List local GGUF files
  clearport use <file>     Select a GGUF model
  clearport status         Check the server and API
  clearport logs           Follow server logs
  clearport stop           Stop the server and release the wake lock
  clearport restart        Restart the server
  clearport config         Edit server configuration
  clearport version        Show CLI version

The server listens on 127.0.0.1:8080 by default.
Configuration: ~/.config/clearport/server.conf
EOF
}

die() { printf 'clearport: %s\n' "$*" >&2; exit 1; }
note() { printf 'clearport: %s\n' "$*"; }
need() { command -v "$1" >/dev/null 2>&1 || die "Missing '$1'. Install it with: pkg install $2"; }

load_config() {
  MODEL_PATH="$HOME/models/model.gguf"
  LLAMA_SERVER_BIN="llama-server"
  HOST="127.0.0.1"
  PORT="8080"
  EXTRA_ARGS=""
  if [ -f "$CONFIG_FILE" ]; then
    # This is the user's private shell-style config file.
    # shellcheck disable=SC1090
    . "$CONFIG_FILE"
  fi
  API_BASE="http://127.0.0.1:$PORT/v1"
}

api_ready() {
  curl -fsS --max-time 3 "$API_BASE/models" >/dev/null 2>&1
}

select_default_model() {
  mkdir -p "$CONFIG_DIR"
  local candidates candidate
  mapfile -t candidates < <(find "$HOME/models" -maxdepth 1 -type f -iname '*.gguf' 2>/dev/null | sort)
  case "${#candidates[@]}" in
    0) die "No GGUF model found in ~/models. Put a .gguf file there, then run: clearport use ~/models/your-model.gguf" ;;
    1) candidate="${candidates[0]}" ;;
    *)
      note "More than one GGUF model was found. Choose one explicitly:"
      printf '  %s\n' "${candidates[@]}"
      die "Run: clearport use <path-to-model.gguf>"
      ;;
  esac
  printf 'MODEL_PATH=%q\nEXTRA_ARGS=%q\n' "$candidate" "-c 2048 -t 4" > "$CONFIG_FILE"
  chmod 600 "$CONFIG_FILE"
  note "Selected model: $candidate"
}

start_server() {
  load_config
  if api_ready; then
    note "A model server is already responding at $API_BASE"
    return 0
  fi
  if [ ! -f "$MODEL_PATH" ]; then
    if [ -f "$CONFIG_FILE" ]; then
      die "Configured model file does not exist: $MODEL_PATH. Select another with 'clearport use <path>'."
    fi
    select_default_model
    load_config
  fi
  command -v "$LLAMA_SERVER_BIN" >/dev/null 2>&1 || die "llama-server is missing. Install it with: pkg install llama-cpp"
  command -v "$SERVER_CMD" >/dev/null 2>&1 || die "clearport-server helper is missing. Re-run the installer."
  if command -v termux-wake-lock >/dev/null 2>&1; then
    termux-wake-lock || true
  fi
  "$SERVER_CMD" start
}

show_status() {
  load_config
  if api_ready; then
    note "API is responding at $API_BASE"
    curl -fsS --max-time 3 "$API_BASE/models" | jq -r '.data[]? | "  Model: " + .id'
    return 0
  fi
  "$SERVER_CMD" status || true
  note "API is not responding at $API_BASE"
  return 1
}

show_models() {
  load_config
  need curl curl
  need jq jq
  curl -fsS --max-time 5 "$API_BASE/models" | jq -r '
    if (.data | length) == 0 then "No models are currently loaded."
    else .data[] | "• " + .id end
  '
}

show_local_models() {
  local found=0
  if [ -d "$HOME/models" ]; then
    while IFS= read -r file; do
      [ -n "$file" ] || continue
      printf '%s\n' "$file"
      found=1
    done < <(find "$HOME/models" -maxdepth 1 -type f -iname '*.gguf' 2>/dev/null | sort)
  fi
  [ "$found" -eq 1 ] || note "No GGUF files found in ~/models."
}

use_model() {
  [ "$#" -eq 1 ] || die "Usage: clearport use <path-to-model.gguf>"
  local model
  model="$(realpath "$1" 2>/dev/null || true)"
  [ -n "$model" ] && [ -f "$model" ] || die "Model file not found: $1"
  case "$model" in
    *.gguf|*.GGUF) ;;
    *) die "Expected a .gguf model file." ;;
  esac
  mkdir -p "$CONFIG_DIR"
  if [ -f "$CONFIG_FILE" ]; then
    grep -Ev '^[[:space:]]*MODEL_PATH=' "$CONFIG_FILE" > "$CONFIG_FILE.tmp" || true
  else
    : > "$CONFIG_FILE.tmp"
  fi
  printf 'MODEL_PATH=%q\n' "$model" >> "$CONFIG_FILE.tmp"
  mv "$CONFIG_FILE.tmp" "$CONFIG_FILE"
  chmod 600 "$CONFIG_FILE"
  note "Model selected: $model"
  note "Run 'clearport restart' to load it."
}

chat() {
  load_config
  need curl curl
  need jq jq
  if ! api_ready; then
    start_server
    note "Waiting for the model API to become ready..."
    local attempt=0
    until api_ready; do
      attempt=$((attempt + 1))
      [ "$attempt" -lt 180 ] || die "Server did not become ready. Check 'clearport logs'."
      sleep 1
    done
  fi

  local model_id messages input payload response answer
  model_id="$(curl -fsS --max-time 5 "$API_BASE/models" | jq -r '.data[0].id // empty')"
  messages='[]'
  printf '\nClearport Chat  |  /clear clears context  |  /exit quits\n\n'
  while true; do
    printf 'you> '
    IFS= read -r input || break
    case "$input" in
      /exit|/quit|exit|quit) break ;;
      /clear) messages='[]'; note "Conversation context cleared."; continue ;;
      '') continue ;;
    esac
    messages="$(jq -c --arg content "$input" '. + [{"role":"user","content":$content}]' <<< "$messages")"
    if [ -n "$model_id" ]; then
      payload="$(jq -cn --arg model "$model_id" --argjson messages "$messages" '{model:$model,messages:$messages,temperature:0.7,max_tokens:512,stream:false}')"
    else
      payload="$(jq -cn --argjson messages "$messages" '{messages:$messages,temperature:0.7,max_tokens:512,stream:false}')"
    fi
    printf 'model> '
    response="$(curl -fsS --max-time 300 "$API_BASE/chat/completions" \
      -H 'Content-Type: application/json' -d "$payload" 2>&1)" || {
        printf '\nRequest failed:\n%s\n' "$response" >&2
        continue
      }
    answer="$(jq -r '.choices[0].message.content // .choices[0].text // empty' <<< "$response" 2>/dev/null || true)"
    [ -n "$answer" ] || {
      printf '\nCould not read the model response:\n%s\n' "$response" >&2
      continue
    }
    printf '%s\n\n' "$answer"
    messages="$(jq -c --arg content "$answer" '. + [{"role":"assistant","content":$content}]' <<< "$messages")"
  done
  printf '\n'
}

stop_server() {
  load_config
  if command -v "$SERVER_CMD" >/dev/null 2>&1; then
    "$SERVER_CMD" stop
  else
    note "clearport-server helper not found."
  fi
  if command -v termux-wake-unlock >/dev/null 2>&1; then
    termux-wake-unlock >/dev/null 2>&1 || true
  fi
}

case "${1:-help}" in
  start) start_server ;;
  chat) chat ;;
  models) show_models ;;
  local-models) show_local_models ;;
  use) shift; use_model "$@" ;;
  status) show_status ;;
  logs) load_config; "$SERVER_CMD" logs ;;
  stop) stop_server ;;
  restart) stop_server; start_server ;;
  config)
    mkdir -p "$CONFIG_DIR"
    touch "$CONFIG_FILE"
    chmod 600 "$CONFIG_FILE"
    "${EDITOR:-nano}" "$CONFIG_FILE"
    ;;
  version|-v|--version) printf 'Clearport CLI %s\n' "$VERSION" ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
